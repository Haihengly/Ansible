version: "3.9"
services:
  db:
    image: mysql:8
    container_name: {{ db_container_name }}
    environment:
      MYSQL_ROOT_PASSWORD: {{ db_password }}
      MYSQL_DATABASE: {{ db_name }}
      MYSQL_USER: {{ db_user }}
      MYSQL_PASSWORD: {{ db_password }}
    ports:
      - "{{ db_port }}:3306"
    volumes:
      - {{ db_volume }}:/var/lib/mysql 
    networks:
      - {{ docker_network }}
    restart: always

networks:
  {{ docker_network }}:
    external: true
